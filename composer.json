{
    "name": "webcraftdg/native-php-framework-demo",
    "description": "Natif projet demo for webcraftdg/native-php-framework-lab",
    "type": "library",
    "keywords": [
        "php",
        "mysql",
        "mariadb",
        "natif",
        "framework",
        "Experimental",
        "laboratory",
        "demo"
    ],
    "license": "MIT",
    "homepage": "https://github.com/webcraftdg/native-php-framework-demo",
    "support": {
        "issues": "https://github.com/webcraftdg/native-php-framework-demo/issues",
        "source": "https://github.com/webcraftdg/native-php-framework-demo"
    },
    "authors": [
        {
            "name": "David Ghyse"
        }
    ],
   "repositories": [
        {
            "type": "path",
            "url": "../native-php-framework-lab"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-dom": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-gd": "*",
        "ext-fileinfo": "*",
        "vlucas/phpdotenv": "~5.0",
        "webcraftdg/native-php-framework-lab": "@dev"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.10"
    },
    "autoload": {
        "psr-4": {
            "contacts\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
        }
    },
    "suggest": {
        "psr/log": "Allows integration with a PSR-3 compatible logger."
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}